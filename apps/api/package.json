{
  "name": "@cvideo/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "db:migrate": "node dist/db/migrate.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts"
  },
  "dependencies": {
    "@cvideo/types": "workspace:*",
    "@cvideo/validation": "workspace:*",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "express": "latest",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "postgres": "3.4.9",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cookie-parser": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "drizzle-kit": "0.31.10",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}

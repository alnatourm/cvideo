NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://cvideo:cvideo_local@localhost:5432/cvideo

# Web uses the Vite proxy locally. Production must route /api to the API on the
# same HTTPS origin; cross-origin browser deployment is not configured in v1.
VITE_API_BASE_URL=

# Expo mobile client. Use a URL reachable from the simulator/device.
# Android emulator commonly uses http://10.0.2.2:4000; a physical device should use the development machine LAN address.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# Video provider. Leave blank to keep production uploads explicitly disabled.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# Private PDF storage. Use a persistent volume outside any publicly served directory.
CV_DOCUMENT_STORAGE_DIR=/var/lib/cvideo/private-documents

# Google Meet production configuration is not implemented yet. Do not add a
# fake meeting-provider value or claim Google Meet readiness.
